{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flock",
  "version": "0.7.44",
  "identifier": "app.flock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "flock",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#121212",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://api.github.com https://github.com https://*.supabase.co wss://*.supabase.co https://presence-auth.vercel.app https://*.ably.io wss://*.ably.io https://*.ably.net wss://*.ably.net https://*.ably-realtime.com wss://*.ably-realtime.com https://theflock.sh https://clarence.minnebo.ai; font-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMERDQkZDREI5OTM3NTEKUldSUk41bmIvTXNOWVpHN0V6SDVXYURwYmppdUxxSWs3QXYxTjhQUmJXTEUweTZrYUFUcHZDMzAK",
      "endpoints": [
        "https://theflock.sh/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/flock-mcp"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-agent terminal cockpit",
    "longDescription": "flock is a desktop cockpit for steering multiple coding agents in parallel across isolated workspaces."
  }
}